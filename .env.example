# ---------- Public configuration (safe to expose to the browser) ----------
# Canonical site URL. Use http://localhost:3000 locally, https://softsmith.dev in production.
NEXT_PUBLIC_SITE_URL=https://softsmith.dev

# Contact details shown on the site. Any left empty are simply hidden.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# International format, digits only, no "+" (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------- Secret configuration (server only, added in Milestone 3) ----------
# Never prefix these with NEXT_PUBLIC_ and never commit real values.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# QUOTE_TO_EMAIL=

# ---------- Development only ----------
# Comma-separated LAN hosts allowed to open the dev server (e.g. from a phone). Ignored in production.
# DEV_ORIGINS=192.168.1.20

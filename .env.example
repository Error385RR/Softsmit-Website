# ---------- Public configuration (safe to expose to the browser) ----------
# Canonical site URL. Use http://localhost:3000 locally, https://softsmith.dev in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact details shown on the site. Any left empty are simply hidden.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# International format, digits only, no "+" (e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------- Secret configuration (server only) ----------
# Never prefix these with NEXT_PUBLIC_ and never commit real values.
# The quote form on /contact emails these credentials via Gmail SMTP.
# If left unset, submissions succeed and are logged to the server console
# instead of emailed — a safe way to test locally before Gmail is set up.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your16charapppassword
# Where quote requests are delivered. Defaults to GMAIL_USER if left unset.
# QUOTE_TO_EMAIL=

# ---------- Development only ----------
# Comma-separated LAN hosts allowed to open the dev server (e.g. from a phone). Ignored in production.
# DEV_ORIGINS=192.168.1.20

# ---------- Dashboard (Supabase) ----------
# Public: safe in the browser (the anon key is protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: the single email address allowed into /admin (lowercase, same as your Supabase user).
ADMIN_EMAIL=
